#!/bin/bash
# ==============================================================================
# AuraLink Linux VPN Privileged Helper
# Executes network routing, TUN interface management, and DNS configuration.
# Designed to be invoked via sudo or polkit.
# ==============================================================================
set -euo pipefail

ACTION="${1:-}"
shift || true

usage() {
  cat <<EOF
Usage: vpn-core-helper <action> [args...]

Actions:
  tun-up <tun_name> <tun_ip>              Create and bring up TUN interface
  tun-down <tun_name>                     Delete TUN interface
  routes-up <server_ip> <gw> <dev> <tun>  Apply static server route and default TUN route
  routes-down <server_ip> <gw> <dev> <tun>Restore physical default route
  dns-up <tun_name> <dns1> [dns2]         Set DNS on TUN interface (with DoT & cache flush)
  dns-down <tun_name>                     Revert DNS on TUN interface
  net-activate <srv> <gw> <dev> <tun> <dns1> <dns2> <ipv6_off> <lo_val>
                                          Atomically disable IPv6, apply routes, and configure DNS
  ipv6-disable [lo_val] [phys_dev]        Disable IPv6 on network interfaces to prevent leaks
  ipv6-restore <all> <def> [if=val...]    Restore saved IPv6 sysctl settings
  kill-all <tun_name>                     Stop any dangling tun2socks processes
  check-deps                              Verify required kernel modules and binaries
  status <tun_name>                       Check interface and routing status
EOF
  exit 1
}

check_root() {
  if [[ $EUID -ne 0 ]]; then
    echo "ERROR: vpn-core-helper must be run as root (or via sudo/pkexec)" >&2
    exit 1
  fi
}

case "$ACTION" in
  tun-up)
    check_root
    TUN="${1:-tun0}"
    IP="${2:-10.0.0.2/24}"
    if ! ip link show "$TUN" >/dev/null 2>&1; then
      ip tuntap add mode tun dev "$TUN"
      ip addr add "$IP" dev "$TUN"
      ip link set "$TUN" up
      echo "TUN interface $TUN created ($IP)"
    else
      echo "TUN interface $TUN already exists"
    fi
    ;;

  tun-down)
    check_root
    TUN="${1:-tun0}"
    if ip link show "$TUN" >/dev/null 2>&1; then
      ip link delete "$TUN" 2>/dev/null || true
      echo "TUN interface $TUN deleted"
    fi
    ;;

  routes-up)
    check_root
    SERVER_IP="${1:?Missing server IP}"
    GW="${2:?Missing gateway IP}"
    DEV="${3:?Missing physical device}"
    TUN="${4:-tun0}"

    echo "[+] Pinning server route: $SERVER_IP/32 via $GW dev $DEV"
    ip route replace "$SERVER_IP/32" via "$GW" dev "$DEV"

    echo "[+] Setting default route via $TUN"
    ip route replace default dev "$TUN"

    echo "[+] Dropping default IPv6 to prevent leaks"
    ip -6 route del default 2>/dev/null || true
    echo "Routes applied successfully."
    ;;

  routes-down)
    check_root
    SERVER_IP="${1:-}"
    GW="${2:-}"
    DEV="${3:-}"
    TUN="${4:-tun0}"

    if [[ -n "$GW" && -n "$DEV" ]]; then
      echo "[+] Restoring default route via $GW dev $DEV"
      ip route replace default via "$GW" dev "$DEV" 2>/dev/null || true
    fi

    if [[ -n "$SERVER_IP" ]]; then
      echo "[+] Removing server route $SERVER_IP/32"
      ip route del "$SERVER_IP/32" 2>/dev/null || true
    fi

    if ip link show "$TUN" >/dev/null 2>&1; then
      ip route del default dev "$TUN" 2>/dev/null || true
    fi
    echo "Routes restored successfully."
    ;;

  dns-up)
    check_root
    TUN="${1:-tun0}"
    DNS1="${2:-1.1.1.1}"
    DNS2="${3:-8.8.8.8}"

    # 1. Try systemd-resolved (only succeeds if systemd-resolved.service is active)
    if command -v resolvectl >/dev/null 2>&1 && resolvectl dns "$TUN" "$DNS1" ${DNS2:+"$DNS2"} >/dev/null 2>&1; then
      resolvectl domain "$TUN" "~." 2>/dev/null || true
      resolvectl default-route "$TUN" yes 2>/dev/null || true
      resolvectl dnsovertls "$TUN" opportunistic 2>/dev/null || true
      resolvectl flush-caches 2>/dev/null || true
      echo "Configured DNS with resolvectl on $TUN ($DNS1${DNS2:+, $DNS2})"
    elif command -v systemd-resolve >/dev/null 2>&1 && systemd-resolve -i "$TUN" --set-dns="$DNS1" --set-domain="~." >/dev/null 2>&1; then
      systemd-resolve --flush-caches 2>/dev/null || true
      echo "Configured DNS with systemd-resolve on $TUN ($DNS1)"
    elif command -v resolvconf >/dev/null 2>&1; then
      {
        echo "nameserver $DNS1"
        [[ -n "$DNS2" ]] && echo "nameserver $DNS2"
      } | resolvconf -a "${TUN}.auralink" 2>/dev/null || true
      echo "Configured DNS with resolvconf on $TUN ($DNS1${DNS2:+, $DNS2})"
    else
      # Fallback for non-systemd distros (Alpine, Void, minimal Debian/Arch)
      if [[ -f /etc/resolv.conf && ! -f /run/auralink-resolv.conf.bak ]]; then
        cp -p /etc/resolv.conf /run/auralink-resolv.conf.bak 2>/dev/null || true
      fi
      {
        echo "# Generated by AuraLink VPN (original backed up at /run/auralink-resolv.conf.bak)"
        echo "nameserver $DNS1"
        [[ -n "$DNS2" ]] && echo "nameserver $DNS2"
      } > /etc/resolv.conf
      echo "Configured DNS directly in /etc/resolv.conf ($DNS1${DNS2:+, $DNS2})"
    fi
    ;;

  net-activate)
    check_root
    SERVER_IP="${1:?Missing server IP}"
    GW="${2:?Missing gateway IP}"
    DEV="${3:?Missing physical device}"
    TUN="${4:-tun0}"
    DNS1="${5:-1.1.1.1}"
    DNS2="${6:-}"
    DISABLE_IPV6="${7:-1}"
    LO_VAL="${8:-0}"

    if [[ -n "$DEV" && ! "$DEV" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
      echo "ERROR: Invalid interface name: $DEV" >&2
      exit 1
    fi

    # 1. Disable IPv6 if requested
    ip -6 route del default 2>/dev/null || true
    if [[ "$DISABLE_IPV6" == "1" ]]; then
      if [[ -w /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
        echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
        echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
        if [[ -n "$DEV" && -w "/proc/sys/net/ipv6/conf/$DEV/disable_ipv6" ]]; then
          echo 1 > "/proc/sys/net/ipv6/conf/$DEV/disable_ipv6"
        fi
        if [[ -w /proc/sys/net/ipv6/conf/lo/disable_ipv6 && ( "$LO_VAL" == "0" || "$LO_VAL" == "1" ) ]]; then
          echo "$LO_VAL" > /proc/sys/net/ipv6/conf/lo/disable_ipv6
        fi
      elif command -v sysctl >/dev/null 2>&1; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=1 net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true
        [[ -n "$DEV" ]] && sysctl -w "net.ipv6.conf.${DEV//./\/}.disable_ipv6=1" >/dev/null 2>&1 || true
        [[ "$LO_VAL" == "0" || "$LO_VAL" == "1" ]] && sysctl -w "net.ipv6.conf.lo.disable_ipv6=${LO_VAL}" >/dev/null 2>&1 || true
      fi
    fi

    # 2. Apply pinned server route + default TUN route
    ip route replace "$SERVER_IP/32" via "$GW" dev "$DEV"
    ip route replace default dev "$TUN"

    # 3. Configure DNS (with opportunistic DoT + cache flush for instant resolution)
    if [[ "$DNS2" == "-" ]]; then
      DNS2=""
    fi
    if command -v resolvectl >/dev/null 2>&1 && resolvectl dns "$TUN" "$DNS1" ${DNS2:+"$DNS2"} >/dev/null 2>&1; then
      resolvectl domain "$TUN" "~." 2>/dev/null || true
      resolvectl default-route "$TUN" yes 2>/dev/null || true
      resolvectl dnsovertls "$TUN" opportunistic 2>/dev/null || true
      resolvectl flush-caches 2>/dev/null || true
    elif command -v systemd-resolve >/dev/null 2>&1 && systemd-resolve -i "$TUN" --set-dns="$DNS1" --set-domain="~." >/dev/null 2>&1; then
      systemd-resolve --flush-caches 2>/dev/null || true
    elif command -v resolvconf >/dev/null 2>&1; then
      {
        echo "nameserver $DNS1"
        [[ -n "$DNS2" ]] && echo "nameserver $DNS2"
      } | resolvconf -a "${TUN}.auralink" 2>/dev/null || true
    else
      if [[ -f /etc/resolv.conf && ! -f /run/auralink-resolv.conf.bak ]]; then
        cp -p /etc/resolv.conf /run/auralink-resolv.conf.bak 2>/dev/null || true
      fi
      {
        echo "# Generated by AuraLink VPN (original backed up at /run/auralink-resolv.conf.bak)"
        echo "nameserver $DNS1"
        [[ -n "$DNS2" ]] && echo "nameserver $DNS2"
      } > /etc/resolv.conf
    fi
    echo "Tunnel network activated on $TUN ($SERVER_IP via $GW dev $DEV, DNS $DNS1)"
    ;;

  dns-down)
    check_root
    TUN="${1:-tun0}"
    if command -v resolvectl >/dev/null 2>&1; then
      resolvectl revert "$TUN" 2>/dev/null || true
      resolvectl flush-caches 2>/dev/null || true
    elif command -v systemd-resolve >/dev/null 2>&1; then
      systemd-resolve --revert -i "$TUN" 2>/dev/null || true
      systemd-resolve --flush-caches 2>/dev/null || true
    fi
    if command -v resolvconf >/dev/null 2>&1; then
      resolvconf -d "${TUN}.auralink" 2>/dev/null || true
    fi
    if [[ -f /run/auralink-resolv.conf.bak ]]; then
      mv -f /run/auralink-resolv.conf.bak /etc/resolv.conf 2>/dev/null || true
    fi
    echo "DNS reverted for $TUN"
    ;;

  ipv6-disable)
    check_root
    LO_VAL="${1:-0}"
    PHYS_DEV="${2:-}"
    if [[ "$LO_VAL" != "0" && "$LO_VAL" != "1" ]]; then
      echo "ERROR: Invalid lo disable_ipv6 value: $LO_VAL" >&2
      exit 1
    fi
    if [[ -n "$PHYS_DEV" && ! "$PHYS_DEV" =~ ^[a-zA-Z0-9_.:-]+$ ]]; then
      echo "ERROR: Invalid interface name: $PHYS_DEV" >&2
      exit 1
    fi

    ip -6 route del default 2>/dev/null || true
    if [[ -w /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
      echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
      echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
      if [[ -n "$PHYS_DEV" && -w "/proc/sys/net/ipv6/conf/$PHYS_DEV/disable_ipv6" ]]; then
        echo 1 > "/proc/sys/net/ipv6/conf/$PHYS_DEV/disable_ipv6"
      fi
      if [[ -w /proc/sys/net/ipv6/conf/lo/disable_ipv6 ]]; then
        echo "$LO_VAL" > /proc/sys/net/ipv6/conf/lo/disable_ipv6
      fi
    elif command -v sysctl >/dev/null 2>&1; then
      sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true
      sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1 || true
      if [[ -n "$PHYS_DEV" ]]; then
        sysctl -w "net.ipv6.conf.${PHYS_DEV//./\/}.disable_ipv6=1" >/dev/null 2>&1 || true
      fi
      sysctl -w "net.ipv6.conf.lo.disable_ipv6=${LO_VAL}" >/dev/null 2>&1 || true
    fi
    echo "IPv6 disabled on network interfaces (leak protection active)."
    ;;

  ipv6-restore)
    check_root
    ALL_VAL="${1:-0}"
    DEF_VAL="${2:-0}"
    shift 2 || true

    if [[ "$ALL_VAL" != "0" && "$ALL_VAL" != "1" ]]; then
      echo "ERROR: Invalid all disable_ipv6 value: $ALL_VAL" >&2
      exit 1
    fi
    if [[ "$DEF_VAL" != "0" && "$DEF_VAL" != "1" ]]; then
      echo "ERROR: Invalid default disable_ipv6 value: $DEF_VAL" >&2
      exit 1
    fi

    if [[ -w /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
      echo "$ALL_VAL" > /proc/sys/net/ipv6/conf/all/disable_ipv6
      echo "$DEF_VAL" > /proc/sys/net/ipv6/conf/default/disable_ipv6
    elif command -v sysctl >/dev/null 2>&1; then
      sysctl -w "net.ipv6.conf.all.disable_ipv6=${ALL_VAL}" >/dev/null 2>&1 || true
      sysctl -w "net.ipv6.conf.default.disable_ipv6=${DEF_VAL}" >/dev/null 2>&1 || true
    fi

    for pair in "$@"; do
      IFACE="${pair%%=*}"
      VAL="${pair#*=}"
      if [[ "$IFACE" =~ ^[a-zA-Z0-9_.:-]+$ && ( "$VAL" == "0" || "$VAL" == "1" ) ]]; then
        if [[ -w "/proc/sys/net/ipv6/conf/$IFACE/disable_ipv6" ]]; then
          echo "$VAL" > "/proc/sys/net/ipv6/conf/$IFACE/disable_ipv6"
        elif command -v sysctl >/dev/null 2>&1; then
          sysctl -w "net.ipv6.conf.${IFACE//./\/}.disable_ipv6=${VAL}" >/dev/null 2>&1 || true
        fi
      fi
    done
    echo "IPv6 settings restored."
    ;;

  kill-all)
    check_root
    TUN="${1:-tun0}"
    pkill -f "tun2socks --device $TUN" 2>/dev/null || true
    pkill -f "tun2socks" 2>/dev/null || true
    if ip link show "$TUN" >/dev/null 2>&1; then
      ip link delete "$TUN" 2>/dev/null || true
    fi
    echo "Stopped tun2socks and cleaned $TUN"
    ;;

  check-deps)
    echo "Checking dependencies..."
    for bin in ip sslocal tun2socks curl jq; do
      if command -v "$bin" >/dev/null 2>&1; then
        echo "  [OK] $bin -> $(command -v "$bin")"
      else
        echo "  [MISSING] $bin"
      fi
    done
    ;;

  status)
    TUN="${1:-tun0}"
    echo "=== TUN Interface ==="
    ip -br link show "$TUN" 2>/dev/null || echo "$TUN: Down / Missing"
    echo ""
    echo "=== Active Default Routes ==="
    ip -4 route show default || true
    echo ""
    echo "=== IPv6 Leak Protection ==="
    if [[ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
      IPV6_ALL="$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)"
      if [[ "$IPV6_ALL" == "1" ]]; then
        echo "IPv6: Disabled (Leak Protected)"
      else
        echo "IPv6: Enabled"
      fi
    else
      echo "IPv6: Unavailable in kernel"
    fi
    echo ""
    echo "=== Processes ==="
    ps aux | grep -E "sslocal|tun2socks" | grep -v grep || echo "No active VPN processes"
    ;;

  *)
    usage
    ;;
esac
