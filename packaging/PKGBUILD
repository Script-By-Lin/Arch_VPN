# Maintainer: AuraLink Team <support@auralink.org>
pkgname=auralink-vpn
pkgver=1.0.0
pkgrel=1
pkgdesc="Cross-Distro Shadowsocks & tun2socks VPN Client for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/Script-By-Lin/Arch_VPN"
license=('GPL3')
depends=('python' 'python-pyqt5' 'shadowsocks-rust' 'tun2socks' 'iproute2' 'curl' 'jq')
optdepends=('systemd-resolvconf: for systemd DNS routing')

package() {
    install -d "$pkgdir/opt/auralink"
    cp -r "$srcdir/core" "$srcdir/gui" "$srcdir/cli" "$srcdir/bin" "$pkgdir/opt/auralink/"

    install -d "$pkgdir/usr/local/bin"
    ln -sf "/opt/auralink/bin/auralink" "$pkgdir/usr/local/bin/auralink"
    ln -sf "/opt/auralink/bin/auralink" "$pkgdir/usr/local/bin/auralink-vpn"
    ln -sf "/opt/auralink/bin/auralink" "$pkgdir/usr/local/bin/shadowtun"
    ln -sf "/opt/auralink/bin/vpn-core-helper" "$pkgdir/usr/local/bin/vpn-core-helper"

    install -Dm644 "$srcdir/packaging/auralink.desktop" "$pkgdir/usr/share/applications/auralink.desktop"
    install -Dm644 "$srcdir/gui/assets/icon.png" "$pkgdir/usr/share/pixmaps/auralink.png"
    install -Dm644 "$srcdir/gui/assets/icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/auralink.svg"
    for s in 16 22 24 32 48 64 128 256 512; do
        if [ -f "$srcdir/gui/assets/icons/auralink_${s}x${s}.png" ]; then
            install -Dm644 "$srcdir/gui/assets/icons/auralink_${s}x${s}.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/auralink.png"
        fi
    done
}
